# Development template only. Supply real values through the process environment
# or a managed secret injector; never commit or copy a populated .env file.
ENV=development
BROKER_TYPE=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GROQ_API_KEY=
VAULT_SECRET_KEY=
VAULT_SECRET_KEY_VERSION=2
# During rotation, keep the previous key available until stored ciphertext has been re-encrypted.
VAULT_SECRET_KEY_PREVIOUS=
VAULT_SECRET_KEY_PREVIOUS_VERSION=1
FIREBASE_SERVICE_ACCOUNT=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_DATA_ONLY=true
WEBULL_LIVE_TRADING_ENABLED=false
WEBULL_SINGLE_TENANT_MODE=false
BROKER_LIVE_TENANT_UID=
# First 16 hex characters of SHA-256(broker account id); required for live writes.
BROKER_LIVE_ACCOUNT_FINGERPRINT=
